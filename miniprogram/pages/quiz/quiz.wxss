.quiz { padding-top: 16rpx; }.quiz-top { margin-bottom: 28rpx; }.mode-pill { font-size: 24rpx; font-weight: 700; border-radius: 12rpx; padding: 8rpx 18rpx; }.mode-pill.poetry { background: var(--mint); color: #226547; }.mode-pill.history { background: #ffe6a4; color: #86551f; }.question-counter { color: var(--muted); font-size: 24rpx; }.question-counter .heavy { color: var(--ink); }
.score-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }.score-label { font-size: 24rpx; margin-right: 16rpx; }.score-number { font-size: 50rpx; font-weight: 900; font-variant-numeric: tabular-nums; line-height: 1; color: var(--primary); }.streak { font-size: 24rpx; color: #5f6986; }
.question-panel { background: white; padding: 28rpx 28rpx 32rpx; border-radius: 28rpx; border: 2rpx solid var(--line); box-shadow: 0 6rpx 0 #e9ecf5; }.question-tag { font-size: 23rpx; font-weight: 600; color: #6d7590; }.timer { display: flex; align-items: baseline; gap: 6rpx; background: #fff0b8; color: #79590c; padding: 2rpx 16rpx; border-radius: 12rpx; font-size: 22rpx; min-width: 96rpx; justify-content: center; }.timer-number { font-size: 34rpx; font-weight: 800; font-variant-numeric: tabular-nums; }.urgent { background: #ffe3e3; color: var(--error); }.time-track { background: #edf0f7; height: 10rpx; border-radius: 8rpx; overflow: hidden; margin-top: 20rpx; }.time-fill { width: 100%; height: 100%; background: var(--primary); transform-origin: left; transition: transform 100ms linear; border-radius: 8rpx; }.urgent-fill { background: #e96560; }
.question-body { min-height: 216rpx; display: flex; flex-direction: column; justify-content: center; padding-top: 28rpx; }.question-prompt { font-size: 36rpx; font-weight: 700; line-height: 1.65; }.poem-body { text-align: center; }.poem-body .question-prompt { font-size: 24rpx; font-weight: 500; color: #737b92; }.verse { font-size: 42rpx; font-weight: 800; line-height: 1.6; margin-top: 16rpx; letter-spacing: 1rpx; }.verse-blank { color: #9aa3ba; margin-top: 12rpx; font-size: 26rpx; }.answer-label { margin: 32rpx 0 18rpx; color: #78819a; font-size: 23rpx; }
.option { width: 100%; min-height: 100rpx; display: flex; align-items: center; text-align: left; background: white; border: 2rpx solid #dfe4f0; border-radius: 20rpx; padding: 18rpx 24rpx; margin-bottom: 18rpx; box-shadow: 0 4rpx 0 #e9ecf4; transition: transform var(--fast), background var(--fast); }.option-letter { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; flex-shrink: 0; font-size: 26rpx; font-weight: 800; background: #edf0fb; color: #5368a9; border-radius: 14rpx; margin-right: 24rpx; }.option-text { font-size: 30rpx; font-weight: 600; line-height: 1.4; flex: 1; }.option-press { background: #eef1ff; border-color: var(--primary); transform: translateY(3rpx); }.option.correct { background: #ddf7e9; border-color: #70bc95; box-shadow: 0 4rpx 0 #b9ddca; color: #17613f; }.correct .option-letter { background: #258557; color: white; }.option.dim { opacity: .5; }.check { font-size: 34rpx; font-weight: 800; margin-left: 12rpx; }.option[disabled] { color: var(--ink); }.option.correct[disabled] { color: #17613f; }
.feedback { min-height: 46rpx; text-align: center; color: #858da2; font-size: 24rpx; margin: 8rpx 0 14rpx; }.feedback.success { color: var(--success); font-weight: 700; }.skip-button { width: 100%; min-height: 88rpx; border: 2rpx dashed #c4cde5; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; color: #4b5d97; font-size: 27rpx; font-weight: 600; background: #eef1fb; }.skip-symbol { font-size: 38rpx; margin-right: 12rpx; }.skip-count { background: white; font-size: 21rpx; padding: 4rpx 12rpx; border-radius: 10rpx; margin-left: 20rpx; }.skip-button.used { color: #8790a6; background: #eceff5; border-color: #d5dbe7; }.quiz-footnote { font-size: 21rpx; color: #9299ab; text-align: center; margin-top: 24rpx; }
.quiz-top, .score-bar, .quiz-actions { flex-shrink: 0; }
.quiz .quiz-top { margin-bottom: 16rpx; }
.quiz .score-bar { margin-bottom: 16rpx; }
.quiz > .time-track { flex-shrink: 0; margin: 0 0 16rpx; }
