.mode-pill.english { background: #dbe9ff; color: #285e9c; }
.quiz .word-body { text-align: center; align-items: center; padding: 20rpx 0 8rpx; }
.word { font-family: "Avenir Next", "PingFang SC", sans-serif; font-size: 54rpx; font-weight: 800; color: #2c4c8b; line-height: 1.3; word-break: break-word; max-width: 100%; }
.word-pronunciation { display: flex; align-items: baseline; justify-content: center; flex-wrap: wrap; gap: 12rpx; margin-top: 10rpx; color: #5b6f8e; }
