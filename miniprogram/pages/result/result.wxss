.result-page { padding-top: 20rpx; }.result-header { text-align: center; }.finish-badge { width: 104rpx; height: 104rpx; background: var(--yellow); border: 3rpx solid #eabf39; border-radius: 30rpx; display: flex; align-items: center; justify-content: center; margin: 0 auto 22rpx; transform: rotate(-8deg); font-size: 68rpx; color: #8b650d; box-shadow: 5rpx 6rpx 0 #efe2b4; }.result-mode { font-size: 23rpx; color: var(--muted); }.result-title { font-size: 44rpx; font-weight: 900; margin-top: 12rpx; }.result-subtitle { color: #7c859a; font-size: 24rpx; margin-top: 12rpx; }
.score-ticket { background: var(--primary); border-radius: 28rpx; text-align: center; color: white; padding: 28rpx; margin-top: 32rpx; }.score-ticket-label { font-size: 24rpx; color: #d6deff; }.final-score { font-size: 104rpx; font-weight: 900; line-height: 1.3; font-variant-numeric: tabular-nums; }.final-score text { font-size: 26rpx; margin-left: 12rpx; font-weight: 500; }.new-record { font-size: 21rpx; letter-spacing: 2rpx; background: var(--yellow); color: #53441d; padding: 4rpx 18rpx; border-radius: 10rpx; display: inline-block; margin-top: 6rpx; }.ticket-divider { border-top: 2rpx dashed #7490ff; margin: 28rpx 0 24rpx; }.ticket-stats { display: flex; justify-content: space-around; }.ticket-stats > view { display: flex; flex-direction: column; flex: 1; }.stat-value { font-size: 30rpx; font-weight: 700; }.stat-value text { font-size: 20rpx; font-weight: 400; }.stat-label { font-size: 21rpx; margin-top: 6rpx; color: #d6deff; }
.review { background: white; border: 2rpx solid var(--line); border-radius: 24rpx; margin-top: 28rpx; padding: 28rpx; }.review-title { font-size: 28rpx; font-weight: 800; display: flex; align-items: center; margin-bottom: 20rpx; }.review-icon { background: #fff0c4; color: #997012; width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; border-radius: 10rpx; margin-right: 12rpx; }.review-question { font-size: 27rpx; line-height: 1.6; font-weight: 600; }.review-question text { font-size: 22rpx; color: var(--muted); font-weight: 400; }.wrong-answer { color: #b44a4e; font-size: 24rpx; margin-top: 18rpx; }.right-answer { color: var(--success); font-size: 27rpx; font-weight: 700; margin-top: 14rpx; }.explanation { color: #67718b; font-size: 24rpx; line-height: 1.8; margin-top: 18rpx; padding-top: 18rpx; border-top: 2rpx solid #f0f2f8; }.source { font-size: 22rpx; color: #858da0; margin-top: 10rpx; }.complete-note { background: #e2f5eb; padding: 28rpx; border-radius: 24rpx; margin-top: 28rpx; color: #357056; font-size: 26rpx; }.storage-note { color: #b44a4e; font-size: 24rpx; margin-top: 20rpx; }.result-actions { margin-top: 32rpx; }.result-actions .secondary-button { margin-top: 24rpx; }.button-arrow { margin-left: 20rpx; }
.result-scroll-inner { padding: 4rpx 2rpx 16rpx; }
.result-page .result-actions { flex-shrink: 0; margin-top: 20rpx; padding-bottom: 8rpx; }
.result-page .primary-button { min-height: 92rpx; }
.result-page .secondary-button { min-height: 80rpx; margin-top: 20rpx; }
.result-page .finish-badge { width: 76rpx; height: 76rpx; font-size: 48rpx; border-radius: 22rpx; margin-bottom: 16rpx; }
.result-page .result-title { font-size: 38rpx; }
.result-page .score-ticket { margin-top: 24rpx; padding: 20rpx 24rpx; }
.result-page .final-score { font-size: 84rpx; }
.result-page .ticket-divider { margin: 20rpx 0 18rpx; }
.review-pronunciation { font-family: "Charis SIL", "Times New Roman", serif; font-size: 27rpx; color: #67718b; margin-top: 8rpx; }
.score-breakdown { font-size: 23rpx; color: #e0e6ff; margin-top: 12rpx; }
.score-breakdown text { margin: 0 10rpx; }
