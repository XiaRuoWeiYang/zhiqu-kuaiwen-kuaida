<view class="page screen result-page enter" wx:if="{{result}}">
  <scroll-view class="content-scroll result-scroll" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}">
  <view class="result-scroll-inner">
  <view class="result-header"><view class="finish-badge">{{result.reason === 'completed' ? '★' : '✦'}}</view><view class="result-mode">{{categoryName}} · 本局结束</view><view class="result-title">{{title}}</view><view class="result-subtitle">{{subtitle}}</view></view>
  <view class="score-ticket"><view class="score-ticket-label">本局积分</view><view class="final-score">{{result.score}}<text>分</text></view><view wx:if="{{result.newBest}}" class="new-record">NEW BEST · 新纪录</view><view wx:if="{{result.scoringVersion === 2}}" class="score-breakdown">答题 {{result.baseScore}} 分 <text>＋</text> 速度 {{result.speedBonus}} 分</view><view class="ticket-divider"></view><view class="ticket-stats"><view><text class="stat-value">{{result.correct}}<text> 题</text></text><text class="stat-label">本局答对</text></view><view><text class="stat-value">{{best}}<text> 分</text></text><text class="stat-label">本类最高</text></view><view><text class="stat-value">{{result.skipUsed ? '已使用' : '未使用'}}</text><text class="stat-label">跳过机会</text></view></view></view>
  <view class="review" wx:if="{{result.question}}"><view class="review-title"><text class="review-icon">!</text>{{result.reason === 'timeout' ? '刚才这题超时了' : '记住这一题'}}</view><view class="review-question">{{result.question.quote || result.question.word || result.question.verse || result.question.prompt}}<text wx:if="{{result.question.word}}"> · {{result.question.partOfSpeech}}</text><text wx:elif="{{result.question.verse}}"> · {{result.question.prompt}}</text></view><view wx:if="{{result.question.phonetic}}" class="review-pronunciation">{{result.question.phoneticAccent}} /{{result.question.phonetic}}/</view><view wx:if="{{result.selectedAnswer}}" class="wrong-answer">你的答案：{{result.selectedAnswer}}</view><view class="right-answer">正确答案：{{result.question.answer}}</view><view class="explanation">{{result.question.explanation}}</view><view class="source">{{result.question.source}}</view></view>
  <view class="complete-note" wx:else>本轮挑战已完成。再来一局，题目将重新抽取！</view>
  <view wx:if="{{!result.saved}}" class="storage-note">本局成绩未能保存到本机，但可以继续挑战。</view>
  </view>
  </scroll-view>
  <view class="result-actions"><button class="primary-button" hover-class="press" bindtap="again">再挑战一次 <text class="button-arrow">↗</text></button><button class="secondary-button" hover-class="press" bindtap="home">返回首页 · 换个玩法</button></view>
</view>
