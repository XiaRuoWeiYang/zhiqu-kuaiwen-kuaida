page {
  height: 100%;
  overflow: hidden;
  --primary: #3659ed;
  --primary-dark: #2542bc;
  --ink: #202640;
  --muted: #737b92;
  --paper: #ffffff;
  --background: #f6f7fb;
  --line: #e5e8f1;
  --yellow: #ffda59;
  --mint: #cbf4e0;
  --success: #16754c;
  --error: #c94045;
  --radius-sm: 20rpx;
  --radius-lg: 36rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --fast: 120ms;
  --normal: 240ms;
  background: var(--background);
  color: var(--ink);
  font-family: "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}
view, button, text { box-sizing: border-box; }
button { margin: 0; padding: 0; font: inherit; line-height: inherit; border-radius: 0; color: inherit; background: transparent; }
button::after { border: none; }
/* 覆盖 style:v2 给默认按钮设置的固定宽度，确保整行卡片和答题按钮铺满容器。 */
button:not([size='mini']) { width: 100%; }
.page { padding: 28rpx 36rpx 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); max-width: 960rpx; margin: 0 auto; }
.page.screen { width: 100%; height: 100%; min-height: 0; display: flex; flex-direction: column; overflow: hidden; padding: 20rpx 32rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
/* 页面本身不滚动，仅让长题目、解析在限定区域内滚动。 */
.content-scroll { height: 0; min-height: 0; flex: 1; width: 100%; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.muted { color: var(--muted); }
.heavy { font-weight: 800; }
.press { opacity: .84; transform: translateY(4rpx); }
.primary-button { width: 100%; min-height: 104rpx; display: flex; align-items: center; justify-content: center; background: var(--primary); color: white; border-radius: var(--radius-sm); font-size: 32rpx; font-weight: 700; box-shadow: 0 8rpx 0 var(--primary-dark); }
.secondary-button { width: 100%; min-height: 96rpx; display: flex; align-items: center; justify-content: center; background: #e9edfa; color: #354575; border-radius: var(--radius-sm); font-weight: 700; }
.section-title { font-size: 34rpx; font-weight: 800; }
.eyebrow { font-size: 22rpx; letter-spacing: 3rpx; font-weight: 700; }
.enter { animation: enter var(--normal) ease-out both; }
@keyframes enter { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { .enter { animation: none; } }
